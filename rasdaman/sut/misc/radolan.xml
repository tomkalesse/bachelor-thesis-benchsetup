<gml:ProjectedCRS
  xmlns:gml="http://www.opengis.net/gml/3.2"
  xmlns:xlink="http://www.w3.org/1999/xlink"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.opengis.net/gml/3.2 http://schemas.opengis.net/gml/3.2.1/gml.xsd"
  gml:id="radolan_crs">

  <!-- identifier + name -->
  <gml:identifier codeSpace="custom">http://localhost:8080/def/crs/custom/0/radolan</gml:identifier>
  <gml:name>RADOLAN Polar Stereographic</gml:name>

  <!-- domainOfValidity (and scope) placed before structural children -->
  <gml:domainOfValidity/>
  <gml:scope/>

  <gml:baseCRS>
    <gml:GeodeticCRS gml:id="radolan_base">
      <gml:identifier codeSpace="custom">http://localhost:8080/def/crs/custom/0/radolan_base</gml:identifier>
      <gml:name>RADOLAN base geodetic CRS (spherical)</gml:name>
      <gml:domainOfValidity/>
      <gml:scope/>

      <gml:datum>
        <gml:GeodeticDatum gml:id="radolan_datum">
          <gml:identifier codeSpace="custom">http://localhost:8080/def/crs/custom/0/radolan_datum</gml:identifier>
          <gml:name>RADOLAN sphere datum</gml:name>

          <gml:ellipsoid>
            <gml:Ellipsoid gml:id="radolan_sphere">
              <gml:identifier codeSpace="custom">radolan_sphere_id</gml:identifier>
              <gml:name>RADOLAN_sphere</gml:name>

              <!-- defining parameters: semiMajorAxis then secondDefiningParameter -->
              <gml:semiMajorAxis uom="m">6370040</gml:semiMajorAxis>
              <gml:secondDefiningParameter>
                <gml:semiMinorAxis uom="m">6370040</gml:semiMinorAxis>
              </gml:secondDefiningParameter>

            </gml:Ellipsoid>
          </gml:ellipsoid>

        </gml:GeodeticDatum>
      </gml:datum>
    </gml:GeodeticCRS>
  </gml:baseCRS>

  <!-- Conversion: name/domainOfValidity/scope BEFORE usesMethod (ordering rasdaman enforces) -->
  <gml:definedByConversion>
    <gml:Conversion gml:id="radolan_conversion">
      <gml:identifier codeSpace="custom">radolan_conversion_id</gml:identifier>
      <gml:name>Polar stereographic conversion for RADOLAN</gml:name>
      <gml:domainOfValidity/>
      <gml:scope/>

      <gml:usesMethod xlink:href="http://www.opengis.net/def/conversion-method/EPSG/0/9810"/>

      <!-- parameterValue: value element first, then operationParameter -->
      <gml:parameterValue>
        <gml:ParameterValue>
          <gml:value uom="deg">90</gml:value>
          <gml:operationParameter xlink:href="http://www.opengis.net/def/parameter/EPSG/0/latitude_of_origin"/>
        </gml:ParameterValue>
      </gml:parameterValue>

      <gml:parameterValue>
        <gml:ParameterValue>
          <gml:value uom="deg">60</gml:value>
          <gml:operationParameter xlink:href="http://www.opengis.net/def/parameter/EPSG/0/standard_parallel_1"/>
        </gml:ParameterValue>
      </gml:parameterValue>

      <gml:parameterValue>
        <gml:ParameterValue>
          <gml:value uom="deg">10</gml:value>
          <gml:operationParameter xlink:href="http://www.opengis.net/def/parameter/EPSG/0/central_meridian"/>
        </gml:ParameterValue>
      </gml:parameterValue>

    </gml:Conversion>
  </gml:definedByConversion>

  <!-- Cartesian CS: identifier before axes; use gml:name and axisAbbrev/axisDirection in allowed order -->
  <gml:usesCartesianCS>
    <gml:CartesianCS gml:id="radolan_cs">
      <gml:identifier codeSpace="custom">radolan_cs_id</gml:identifier>

      <gml:axis>
        <gml:CoordinateSystemAxis gml:id="radolan_axis_E" uom="m">
          <gml:identifier codeSpace="custom">E_axis</gml:identifier>
          <gml:name>Easting</gml:name>
          <gml:axisAbbrev>E</gml:axisAbbrev>
          <gml:axisDirection codeSpace="custom">east</gml:axisDirection>
        </gml:CoordinateSystemAxis>
      </gml:axis>

      <gml:axis>
        <gml:CoordinateSystemAxis gml:id="radolan_axis_N" uom="m">
          <gml:identifier codeSpace="custom">N_axis</gml:identifier>
          <gml:name>Northing</gml:name>
          <gml:axisAbbrev>N</gml:axisAbbrev>
          <gml:axisDirection codeSpace="custom">north</gml:axisDirection>
        </gml:CoordinateSystemAxis>
      </gml:axis>

    </gml:CartesianCS>
  </gml:usesCartesianCS>

</gml:ProjectedCRS>
